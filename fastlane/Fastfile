# Pessimal iOS signing, build and TestFlight upload.
#
# Deliberately mirrors the sibling project Pocket Companion (bande-a-bonnot/fastlane/Fastfile): the
# same secret names, the same lane shape, the same division of labour where fastlane owns signing and
# Bazel owns the build. One Doppler deployment config can therefore serve both, and anyone who knows
# one knows the other.
#
# Secrets come from Doppler project `lightless-labs-pessimal`, config `prd_ios_deployment`, read by
# the same service account pocket-claw uses:
#   APPLE_DISTRIBUTION_CERTIFICATE_P12_BASE64   Apple Distribution cert + key, base64 of a .p12
#   APPLE_DISTRIBUTION_CERTIFICATE_PASSWORD     that .p12's password
#   APP_STORE_CONNECT_API_KEY_ID                App Store Connect API key id
#   APP_STORE_CONNECT_API_KEY_ISSUER_ID         its issuer id
#   APP_STORE_CONNECT_API_KEY_BASE64            the .p8, base64
#   APPLE_TEAM_ID                               the team that owns them (PKPPLFK854, band-wide)
#   GH_TOKEN                                    for the release notes and tag push
#
# Run a lane with the config injected:
#   doppler run -p lightless-labs-pessimal -c prd_ios_deployment -- bundle exec fastlane pessimal_beta_testflight
#
# The project's other config belongs to another job and is not read here: `prd_macos_notarisation`
# serves scripts/notarize-macos-app.sh. There is no app-runtime config, because the app asks the user
# for the backend URL and key rather than shipping a shared one in the bundle.
#
# The provisioning profile is NOT a stored secret: it is fetched from the portal read-only with the
# App Store Connect key, so it cannot drift out of date in a vault.

require "shellwords"
require "base64"
require "tempfile"
require "securerandom"
require "tmpdir"
require "fileutils"

default_platform(:ios)

PROJECT_ROOT = File.expand_path("..", __dir__)

# Its own keychain, never the login one, and not in ~/Library/Keychains either: the host should come
# out of a lane exactly as it went in. The certificate goes into a keychain inside a 0700 temp
# directory, and both the keychain and the search-list entry are removed however the lane ends.
SIGNING_KEYCHAIN_BASENAME = "pessimal-signing.keychain"

IOS_APPS = {
  pessimal: {
    display_name: "Pessimal",
    bundle_id: "com.lightless-labs.pessimal.ios",
    profile_name: "com.lightless-labs.pessimal.ios",
    bazel_target: "//clients/apple/ios:Pessimal",
    ipa_path: File.join(PROJECT_ROOT, ".bazel", "bin", "clients/apple/ios", "Pessimal.ipa"),
    tag_prefix: "pessimal-ios",
    # Pessimal asks for nothing privileged: no background execution, no location, no push. If that
    # changes, list the entitlement here so a profile missing it fails before the upload rather than
    # at review.
    required_profile_entitlements: {},
  },
}.freeze

def ios_app!(key)
  IOS_APPS.fetch(key) do
    UI.user_error!("Unknown iOS app #{key.inspect}. Known apps: #{IOS_APPS.keys.join(', ')}")
  end
end

def write_p12_to_temp
  file = Tempfile.new(["dist_cert", ".p12"])
  file.binmode
  file.write(Base64.decode64(ENV.fetch("APPLE_DISTRIBUTION_CERTIFICATE_P12_BASE64")))
  file.close
  # Removed on exit however the lane ends: a distribution certificate left in a temp directory is a
  # credential left behind.
  at_exit { file.unlink rescue nil }
  file.path
end

def configure_app_store_connect_api_key_if_present
  asc_vars = %w[APP_STORE_CONNECT_API_KEY_ID APP_STORE_CONNECT_API_KEY_ISSUER_ID APP_STORE_CONNECT_API_KEY_BASE64]
  present = asc_vars.select { |v| ENV[v] && !ENV[v].empty? }
  return if present.empty?

  # All three or none. A partial set otherwise fails much later, inside sigh, with an error that
  # names none of the missing variables.
  missing = asc_vars - present
  UI.user_error!("Incomplete App Store Connect API key config: missing #{missing.join(', ')}") if missing.any?

  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_BASE64"),
    is_key_content_base64: true,
    in_house: false,
  )
end

# The user's keychain search list, as `security` reports it: one quoted path per line.
def user_keychain_search_list
  `security list-keychains -d user`.scan(/"([^"]*)"/).flatten
end

def quietly(*command)
  system(*command, out: File::NULL, err: File::NULL)
end

# `import_certificate` does not create the keychain it imports into. It resolves the name to a path
# and fails with "Could not locate the provided keychain" if nothing is there. Pocket Companion omits
# the create step and works anyway, because its self-hosted runner has one left over from an earlier
# run -- a dependency on machine state rather than a design. phil-connors and kumbaya made a
# temporary one per job in their old get-mac CI, which is the behaviour reproduced here, except that
# it belongs to the lane so a run by hand gets it too.
def create_signing_keychain!
  @signing_keychain_dir = Dir.mktmpdir("pessimal-signing")
  @signing_keychain_path = File.join(@signing_keychain_dir, SIGNING_KEYCHAIN_BASENAME)
  # Captured before anything is added, and restored verbatim on the way out: deleting a keychain is
  # supposed to drop it from the search list, and this makes that not have to be true. Restored
  # verbatim even when what was captured is wrong -- the host's keychain configuration belongs to the
  # host, and a build lane quietly rewriting it is its own kind of pollution.
  @original_search_list = user_keychain_search_list

  # A search list can be left holding paths that no longer exist -- a script that built the list from
  # the indented, quoted output of `security list-keychains` without unquoting it is the usual way.
  # codesign then finds no identities and says only that signing failed, so it is worth naming here.
  dangling = @original_search_list.reject { |path| File.exist?(path) }
  unless dangling.empty?
    UI.important("The keychain search list holds #{dangling.count} path(s) that do not exist:")
    dangling.each { |path| UI.important("  #{path}") }
    UI.important("codesign searches this list. If signing fails with no identity found, repair it:")
    UI.important("  security list-keychains -d user -s ~/Library/Keychains/login.keychain-db")
  end

  password = SecureRandom.hex(24)
  create_keychain(
    path: @signing_keychain_path,
    password: password,
    default_keychain: false, # never displace the login keychain
    unlock: true,
    # codesign searches the list, so the identity has to be on it -- which is the one thing a lane
    # cannot do without touching host configuration. Hence restoring the list afterwards.
    add_to_search_list: true,
    # Long enough that a cold Bazel build cannot lock it out from under codesign. The bound on how
    # long the certificate is available is the lane's lifetime, not this.
    timeout: 3600,
    lock_when_sleeps: true,
  )
  password
end

def remove_signing_keychain!
  return if @signing_keychain_path.nil?

  quietly("security", "delete-keychain", @signing_keychain_path)
  unless @original_search_list.nil? || @original_search_list.empty?
    quietly("security", "list-keychains", "-d", "user", "-s", *@original_search_list)
  end
  FileUtils.remove_entry(@signing_keychain_dir) if @signing_keychain_dir && File.directory?(@signing_keychain_dir)
ensure
  @signing_keychain_path = nil
  @signing_keychain_dir = nil
  @original_search_list = nil
end

# Every lane that signs runs inside this. `ensure` covers a raised error and a fastlane
# `user_error!`; the at_exit backstop covers an exit that unwinds some other way. Neither covers
# SIGKILL, which is why the keychain is in a temp directory and not in ~/Library/Keychains.
def with_signing_keychain
  at_exit { remove_signing_keychain! }
  yield
ensure
  remove_signing_keychain!
end

def fetch_ios_signing(app)
  configure_app_store_connect_api_key_if_present

  # Keyed on the secret being available rather than on CI, so a first run by hand takes the same
  # hermetic path as a run on a build machine. Without the secret, codesign falls back to whatever
  # Apple Distribution identity the login keychain already holds.
  if ENV["APPLE_DISTRIBUTION_CERTIFICATE_P12_BASE64"]
    keychain_password = create_signing_keychain!
    import_certificate(
      certificate_path: write_p12_to_temp,
      certificate_password: ENV.fetch("APPLE_DISTRIBUTION_CERTIFICATE_PASSWORD"),
      keychain_path: @signing_keychain_path,
      keychain_password: keychain_password,
    )
  else
    UI.important("No APPLE_DISTRIBUTION_CERTIFICATE_P12_BASE64; relying on the login keychain")
  end

  # readonly: never create or regenerate a profile from CI. A profile silently recreated on a build
  # machine is how a team ends up with several and no idea which one ships.
  profile_result = get_provisioning_profile(
    app_identifier: app.fetch(:bundle_id),
    provisioning_name: app.fetch(:profile_name),
    readonly: true,
  )
  profile_path = profile_result if profile_result && File.exist?(profile_result)
  profile_path ||= Actions.lane_context[SharedValues::SIGH_PROFILE_PATH]
  unless profile_path && File.exist?(profile_path)
    UI.user_error!("No provisioning profile for #{app.fetch(:display_name)} (#{app.fetch(:bundle_id)})")
  end
  profile_path
end

def build_ios_app(app, options)
  variant = options[:variant] || "beta"
  version = options[:version] || "0.1.0"
  build_number = options[:build_number] || ENV["GITHUB_RUN_NUMBER"] || ENV["BUILDKITE_BUILD_NUMBER"] || "1"

  unless version.match?(/\A\d+\.\d+\.\d+\z/)
    UI.user_error!("Invalid version #{version.inspect}; expected semver such as 1.2.3")
  end

  bazel_args = [
    "build", app.fetch(:bazel_target),
    "--config=#{variant.shellescape}",
    "--config=ios_device",
    "--embed_label=#{version}.#{build_number.to_s.shellescape}",
    "--ios_multi_cpus=arm64",
  ]

  sh("bazelisk", *bazel_args)

  ipa_path = app.fetch(:ipa_path)
  UI.user_error!("No ipa at #{ipa_path} after a successful build") unless File.exist?(ipa_path)
  ipa_path
end

def upload_ios_testflight(app, options)
  configure_app_store_connect_api_key_if_present
  upload_to_testflight(
    ipa: app.fetch(:ipa_path),
    app_identifier: app.fetch(:bundle_id),
    changelog: options[:changelog] || "Pessimal beta build.",
    skip_waiting_for_build_processing: !options[:wait_for_build_processing],
  )
end

platform :ios do
  # The signing keychain does not outlive the process that made it, so `pessimal_fetch_signing`
  # followed by a separate `fastlane pessimal_build` cannot share one. Each lane that signs sets up
  # its own; use pessimal_beta_testflight for a real release.
  desc "Check that the distribution certificate and provisioning profile resolve"
  lane :pessimal_fetch_signing do
    with_signing_keychain { fetch_ios_signing(ios_app!(:pessimal)) }
  end

  desc "Build the Pessimal ipa for a device"
  lane :pessimal_build do |options|
    app = ios_app!(:pessimal)
    with_signing_keychain do
      fetch_ios_signing(app)
      build_ios_app(app, options)
    end
  end

  desc "Upload an already-built Pessimal ipa to TestFlight"
  lane :pessimal_upload_testflight do |options|
    upload_ios_testflight(ios_app!(:pessimal), options)
  end

  desc "Sign, build and upload a Pessimal beta to TestFlight"
  lane :pessimal_beta_testflight do |options|
    app = ios_app!(:pessimal)
    with_signing_keychain do
      fetch_ios_signing(app)
      build_ios_app(app, options)
    end
    upload_ios_testflight(
      app,
      changelog: options[:changelog],
      wait_for_build_processing: options[:wait_for_build_processing],
    )
  end
end
