load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_static_library")

# Cargo.toml is compile_data because UniFFI's proc-macros read it to learn the crate name; without
# it the generated scaffolding and the generated bindings disagree and the app panics at its first
# call with a checksum mismatch.
exports_files(["Cargo.toml"])

_DEPS = all_crate_deps(normal = True) + [
    "//common/pessimal_core",
    "//common/pessimal_usage",
    "//common/pessimal_usage_otlp",
    "//clients/common/pessimal_client_core",
    "//clients/common/query/pessimal_query_signoz",
]

rust_library(
    name = "pessimal_ffi",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["Cargo.toml"],
    crate_name = "pessimal_ffi",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = _DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

# What an iOS app links against. The generated Swift calls into these symbols.
rust_static_library(
    name = "pessimal_ffi_static",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["Cargo.toml"],
    crate_name = "pessimal_ffi",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = _DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
)
