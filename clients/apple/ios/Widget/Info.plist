<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>PessimalWidget</string>
	<key>CFBundleDisplayName</key>
	<string>Pessimal</string>
	<key>CFBundleIdentifier</key>
	<string>com.lightless-labs.pessimal.ios.widget</string>
	<key>CFBundleExecutable</key>
	<string>PessimalWidgetExtension</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<!-- The same reason as the app's: HTTPS only, which is exempt, and without the key App Store
	     Connect asks about export compliance on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Overwritten by the build from the same version target as the app. App Store validation
	     refuses an extension whose versions differ from its app's. -->
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<!-- Required of every 64-bit binary in an upload, extensions included. Without it App Store
	     Connect refuses the whole build after it has been signed and uploaded (validation error
	     -19241, measured on Buildkite builds #92-#94). Matches the app's own value. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.widgetkit-extension</string>
	</dict>
</dict>
</plist>
