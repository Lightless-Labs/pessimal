load("@rules_apple//apple:apple.bzl", "local_provisioning_profile")
load("@rules_apple//apple:ios.bzl", "ios_application", "ios_extension")
load("@rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_xcodeproj//xcodeproj:defs.bzl", "xcode_provisioning_profile")

swift_library(
    name = "PessimalIOSLib",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "PessimalIOS",
    tags = ["manual"],
    deps = [
        "//clients/apple/PessimalFFI",
        "//clients/apple/PessimalKit",
    ],
)

# The widget extension's code (M11). Its own module: an extension is a separate process with a
# 30 MB limit, and linking the app's views into it would spend that on code it never runs.
swift_library(
    name = "PessimalWidgetLib",
    srcs = glob(["Widget/Sources/**/*.swift"]),
    module_name = "PessimalWidget",
    tags = ["manual"],
    deps = [
        "//clients/apple/PessimalFFI",
        "//clients/apple/PessimalKit",
    ],
)

# =============================================================================
# Code signing
# =============================================================================
# Every profile target is tagged "manual" so `bazel build //...` does not try to resolve one on a
# machine that has no profiles installed -- which is every CI runner.
#
# `local_provisioning_profile` searches ~/Library/MobileDevice/Provisioning Profiles and matches on
# the profile's *Name* field, not its filename. Nothing here downloads anything: Xcode populates
# that directory for development, and `scripts/asc.py install-profile` does for distribution.
#
# The team is the same one every app in the band ships under, so it is written here rather than
# threaded through a flag. `local_provisioning_profile` treats it as optional -- it only
# disambiguates two accounts holding a profile of the same name -- but `xcode_provisioning_profile`
# requires it, either directly or propagated from the profile it wraps.

# Development signing, for running on a real device. Build once for device in Xcode first: that is
# what creates the team profile this matches.
local_provisioning_profile(
    name = "local_profile",
    profile_name = "iOS Team Provisioning Profile: *",
    tags = ["manual"],
    team_id = "PKPPLFK854",
)

# Lets `bazel run //:xcodeproj` hand signing back to Xcode for device debugging.
xcode_provisioning_profile(
    name = "xcode_profile",
    managed_by_xcode = True,
    provisioning_profile = ":local_profile",
    tags = ["manual"],
)

# TestFlight and App Store signing. The profile name has to match in three places, and a mismatch
# surfaces as "no profile found" at build time rather than as anything about naming:
#   1. the name of the profile in the Apple Developer portal,
#   2. profile_name here,
#   3. PROFILE_NAME in scripts/release-ios-testflight-buildkite.sh.
local_provisioning_profile(
    name = "distribution_profile",
    profile_name = "com.lightless-labs.pessimal.ios",
    tags = ["manual"],
    team_id = "PKPPLFK854",
)

# The widget extension's own App Store profile. An extension is signed separately from its app, with
# its own App ID (com.lightless-labs.pessimal.ios.widget). The same three places must agree on the
# name as for the app's: the portal, profile_name here, and WIDGET_PROFILE_NAME in
# scripts/release-ios-testflight-buildkite.sh.
local_provisioning_profile(
    name = "widget_distribution_profile",
    profile_name = "com.lightless-labs.pessimal.ios.widget",
    tags = ["manual"],
    team_id = "PKPPLFK854",
)

# =============================================================================
# Versioning
# =============================================================================
# Fed by `--embed_label=<version>.<build>`, which scripts/release-ios-testflight-buildkite.sh passes. Without this target the label is
# inert and CFBundleVersion stays whatever Info.plist says -- so every upload would carry the same
# build number and App Store Connect would reject the second one.
apple_bundle_version(
    name = "app_version",
    build_label_pattern = "{version}.{build}",
    build_version = "{version}.{build}",
    capture_groups = {
        "version": "\\d+\\.\\d+\\.\\d+",
        "build": "\\d+",
    },
    fallback_build_label = "0.1.0.1",
    short_version_string = "{version}",
)

# =============================================================================
# Usage-reporting destination
# =============================================================================
# Pessimal's own traces go to Lightless Labs' SigNoz, opt-out. The destination is injected at build
# time exactly the way kumbaya and phil-connors do it, rather than through a third mechanism:
#
#   bazel build //clients/apple/ios:Pessimal \
#       --action_env=SIGNOZ_OTLP_ENDPOINT=https://ingest.eu2.signoz.cloud \
#       --action_env=SIGNOZ_OTLP_INGESTION_KEY=...
#
# `PessimalServices.swift` reads these from `Bundle.main.infoDictionary` and hands them to
# `FleetSession`, which builds a reporter only if consent also allows one.
#
# `$${VAR:-}` expands to an EMPTY STRING when the variable is unset, and that is the whole
# "test builds cannot phone home" guarantee: `Destination::from_bundle` treats empty as no
# destination at all, so a `--config=ci` simulator build — which is never given the flags — reports
# nothing by construction rather than by a runtime check. The key is never committed; it reaches the
# build only from Doppler, through the release lane.
genrule(
    name = "usage_plist",
    outs = ["UsageConfig.plist"],
    cmd = """cat > $@ << PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>SIGNOZ_OTLP_ENDPOINT</key>
    <string>$${SIGNOZ_OTLP_ENDPOINT:-}</string>
    <key>SIGNOZ_OTLP_INGESTION_KEY</key>
    <string>$${SIGNOZ_OTLP_INGESTION_KEY:-}</string>
</dict>
</plist>
PLISTEOF""",
)

# The home and lock screen widgets (M11). See docs/plans/2026-10-02-m11-ios-widgets.md.
ios_extension(
    name = "PessimalWidgetExtension",
    bundle_id = "com.lightless-labs.pessimal.ios.widget",
    # Keyed exactly like the app's, per the CLAUDE.md caution: every branch gets the file, the
    # simulator included, because the widget reads the shared keychain item in the simulator too.
    entitlements = select({
        "//:beta_build": "Widget/PessimalWidget.entitlements",
        "//:release_build": "Widget/PessimalWidget.entitlements",
        "//:ci_build": "Widget/PessimalWidget.entitlements",
        "//conditions:default": "Widget/PessimalWidget.entitlements",
    }),
    families = ["iphone", "ipad"],
    infoplists = ["Widget/Info.plist"],
    minimum_os_version = "17.0",
    provisioning_profile = select({
        "//:beta_build": ":widget_distribution_profile",
        "//:release_build": ":widget_distribution_profile",
        "//:ci_build": None,
        # No local Xcode profile for the extension: nobody builds this for a device by hand.
        "//conditions:default": None,
    }),
    # The app's own version target. App Store validation refuses an extension whose versions
    # differ from its app's.
    version = ":app_version",
    deps = [":PessimalWidgetLib"],
)

ios_application(
    name = "Pessimal",
    bundle_id = "com.lightless-labs.pessimal.ios",
    # Generated by tools/appicon/render-app-icon.swift, at every pixel size the catalog declares.
    # App Store validation names exact sizes -- 120 for iPhone, 152 for iPad -- and a bundle with no
    # icon is rejected after the upload, which is the slowest possible place to learn it.
    app_icons = glob(["Resources/AppIcon.xcassets/**"]),
    # The app's first entitlements file, for the keychain group it mirrors its connection into for
    # the widget. Keyed like provisioning_profile; M9 stage 5 adds the iCloud key-value store here.
    entitlements = select({
        "//:beta_build": "Resources/Pessimal.entitlements",
        "//:release_build": "Resources/Pessimal.entitlements",
        "//:ci_build": "Resources/Pessimal.entitlements",
        "//conditions:default": "Resources/Pessimal.entitlements",
    }),
    extensions = [":PessimalWidgetExtension"],
    families = ["iphone", "ipad"],
    infoplists = [
        "Resources/Info.plist",
        ":usage_plist",
    ],
    # Apple's privacy manifest, required at App Store review now that the app collects anything at all
    # — TestFlight let 0.1.0 through without one.
    #
    # Through `resources` rather than a dedicated attribute: this rules_apple has no
    # `privacy_manifests`, and naming an attribute that does not exist is an analysis failure rather
    # than a warning. `resources` places the file at the bundle root, which is where Apple looks.
    resources = ["Resources/PrivacyInfo.xcprivacy"],
    # 14.0 keeps parity with the macOS app's floor; SwiftUI's Observation needs 17 at runtime, and
    # the views guard accordingly rather than excluding older devices from the whole app.
    minimum_os_version = "17.0",
    provisioning_profile = select({
        "//:beta_build": ":distribution_profile",
        "//:release_build": ":distribution_profile",
        "//:ci_build": None,  # simulator, nothing to sign, and no profiles installed to find
        "//conditions:default": ":xcode_profile",
    }),
    version = ":app_version",
    visibility = ["//visibility:public"],
    deps = [":PessimalIOSLib"],
)
