# =============================================================================
# Pessimal Bazel configuration
# =============================================================================
# Bazel builds the Apple clients. The agents build with Cargo.

common --enable_bzlmod

build --@rules_rust//rust/toolchain/channel=stable

# =============================================================================
# Apple targets
# =============================================================================
build:ios --apple_platform_type=ios

# --ios_multi_cpus is not redundant with --platforms. rules_apple decides device-versus-simulator
# from the legacy Apple CPU configuration, so --platforms=//platforms:ios_arm64 on its own produces
# an arm64 bundle whose Info.plist still says DTPlatformName=iphonesimulator: unsignable, and
# installable on nothing. Verified by inspecting the ipa.
build:ios_device --config=ios
build:ios_device --platforms=//platforms:ios_arm64
build:ios_device --ios_multi_cpus=arm64

build:ios_sim --config=ios
build:ios_sim --platforms=//platforms:ios_sim_arm64
build:ios_sim --ios_multi_cpus=sim_arm64

# =============================================================================
# Memory
# =============================================================================
# The development machine is an 11 GB VM that runs with most of its swap in use, where the Bazel
# server cannot finish starting inside the client's default connect window. These keep it from
# competing with cargo for what little memory there is; raise them on a larger machine.
startup --host_jvm_args=-Xmx1500m
startup --connect_timeout_secs=900
build --local_resources=memory=HOST_RAM*.4

build --disk_cache=~/.cache/bazel-pessimal
build --symlink_prefix=.bazel/

# =============================================================================
# Shared by CI and every distribution variant
# =============================================================================
build:ci-base --show_progress_rate_limit=5
build:ci-base --noshow_loading_progress
build:ci-base --keep_going=false

# =============================================================================
# Distribution variants, driven by fastlane (see fastlane/Fastfile)
# =============================================================================
# compilation_mode=opt is not about speed. A fastbuild iOS binary carries the
# get-task-allow entitlement, which TestFlight and the App Store both reject, so a
# variant that forgets this fails at upload rather than at build -- after signing,
# after the slow part.
#
# These extend ci-base rather than ci: `ci` and a variant both matching would make the
# provisioning_profile select in //clients/apple/ios ambiguous rather than specialised, and the
# simulator platform ci pins would leak into a device build.
#
# The target platform is deliberately absent: fastlane adds `--config=ios_device`, and leaving it out
# here keeps the one flag that decides signing next to the one tool that can satisfy it. It does not
# buy a simulator variant build -- `--config=beta --config=ios_sim` still fails looking for the
# distribution profile, because Bazel builds the profile target whether or not the simulator bundle
# would consume it. Use `--config=ci` to check that the app compiles without credentials.
build:beta --config=ci-base
build:beta --compilation_mode=opt
build:beta --define variant=beta

build:release --config=ci-base
build:release --compilation_mode=opt
build:release --define variant=release

# =============================================================================
# CI
# =============================================================================
build:ci --config=ci-base
# Signing is unavailable on a hosted runner: no certificate, and no provisioning profile in
# ~/Library/MobileDevice. `ci=true` is what tells the app target to ask for neither.
build:ci --define ci=true
build:ci --config=ios_sim

test --test_output=errors
