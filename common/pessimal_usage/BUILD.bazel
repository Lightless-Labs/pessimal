load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Pessimal's own usage reporting, pure: span types, the attribute allowlist, consent, and the
# OTLP/JSON encoder. No I/O, so nothing here is platform-specific.
exports_files(["Cargo.toml"])

rust_library(
    name = "pessimal_usage",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["Cargo.toml"],
    crate_name = "pessimal_usage",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "pessimal_usage_test",
    compile_data = ["Cargo.toml"],
    crate = ":pessimal_usage",
    edition = "2024",
)
