# Root package: exports the files Bazel extensions need, and nothing else.

package(default_visibility = ["//visibility:private"])

exports_files([
    "Cargo.toml",
    "Cargo.lock",
])

# =============================================================================
# Build variants
# =============================================================================
# These exist so `clients/apple/ios` can select a provisioning profile without the BUILD file
# knowing anything about who is building. Set by the .bazelrc configs of the same name; the
# distribution variants deliberately extend `ci-base` rather than `ci`, because `ci` and a variant
# both matching would make the select ambiguous rather than specialised.

# A CI build has no provisioning profiles installed, so it signs nothing and targets the simulator.
config_setting(
    name = "ci_build",
    define_values = {"ci": "true"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "beta_build",
    define_values = {"variant": "beta"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "release_build",
    define_values = {"variant": "release"},
    visibility = ["//visibility:public"],
)

load("@rules_xcodeproj//xcodeproj:defs.bzl", "top_level_target", "xcodeproj")

# Generate the Xcode project:  bazel run //:xcodeproj
#
# It exists for App Store submission and for anyone who wants to debug the iOS app in Xcode. The
# Rust targets are deliberately absent from the project navigator: Bazel builds them, and listing
# them would bury the Swift under a hundred external crates.
xcodeproj(
    name = "xcodeproj",
    project_name = "Pessimal",
    install_directory = "products/ios",
    tags = ["manual"],
    top_level_targets = [
        top_level_target(
            "//clients/apple/ios:Pessimal",
            target_environments = ["device", "simulator"],
        ),
    ],
)
